# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Gemini Model for autonomous reasoning and intent parsing
# Options: gemini-3.6-flash, gemini-2.5-flash, gemini-1.5-pro
AGENT_MODEL=gemini-3.6-flash

# 2. Razorpay Test Mode Credentials
# Obtain these from your Razorpay Dashboard in TEST MODE:
# Dashboard URL: https://dashboard.razorpay.com/app/keys
# (Make sure the toggle at the top is switched to "Test Mode")

# Razorpay Test Key ID (Starts with `rzp_test_...`)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# Razorpay Test Key Secret
RAZORPAY_KEY_SECRET=yourKeySecretHere

# Razorpay Webhook Secret (configured in Dashboard > Settings > Webhooks)
# Used for cryptographically verifying incoming X-Razorpay-Signature (HMAC-SHA256)
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Execution Mode:
# - `mock`: Uses deterministic local simulator (default, great for offline testing and CI)
# - `test`: Uses live Razorpay Test Mode API at https://api.razorpay.com
RAZORPAY_MODE=mock

# 3. Optional RazorpayX / Payout Configuration (if utilizing RazorpayX Banking APIs)
# RazorpayX Account Number (from RazorpayX Dashboard in test mode)
RAZORPAYX_ACCOUNT_NUMBER=

# 4. App & Protocol Settings
# Commerce & Protocol flow
FLOW=razorpay
DEFAULT_CURRENCY=INR

# Directory paths for runtime state and structured audit logs
LOGS_DIR=.logs
TEMP_DB_DIR=.temp-db

# 5. Buyer Balance & Spending Authority Defaults
BUYER_AVAILABLE_BALANCE=50000.0
BUYER_TRANSACTION_LIMIT=10000.0

